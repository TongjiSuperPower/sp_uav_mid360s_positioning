Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Name: Mid360 PointCloud
      Topic: /livox/lidar
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Down Camera
      Topic: /x500_lidar_cam/camera/image
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Name: LIO Odometry
      Topic: /Odometry
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
Window Geometry:
  Height: 800
  Width: 1200
